# Environment Configuration for RAG Application

# Core Environment Settings (Required)
# ----------------------------------
FLASK_APP=src.api:app
FLASK_ENV=development
FLASK_DEBUG=1
HOST=localhost
PORT=5000

# API Keys (Required)
# ------------------
OPENAI_API_KEY=your-openai-api-key-here

# Storage Paths (Environment-specific)
# ----------------------------------
# Database storage
CHROMA_COLLECTION_NAME=documentation
CHROMA_PERSIST_DIR=./chroma_db

# Cache and model storage
TRANSFORMERS_CACHE=./cache/huggingface
TIKTOKEN_CACHE_DIR=./cache/tiktoken
TORCH_HOME=./cache/torch
SENTENCE_TRANSFORMERS_HOME=./model_cache

# File storage
UPLOAD_FOLDER=./uploads
TMP_DIR=./tmp

# Model Configuration
# ------------------
EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2

# Default Values for Dynamic Settings
# ---------------------------------
# These provide initial values but can be changed at runtime through the settings API

# LLM settings
OPENAI_MODEL=gpt-3.5-turbo
DEFAULT_TEMPERATURE=0.3
DEFAULT_MAX_TOKENS=1000

# Document processing
DEFAULT_CHUNK_SIZE=500
DEFAULT_CHUNK_OVERLAP=50

# Cache configuration
RESPONSE_CACHE_ENABLED=true
RESPONSE_CACHE_SIZE=1000

# Note: Some settings previously in this file have been moved to constants.py
# as they are fundamental to the application and should not be configured
# through environment variables.
